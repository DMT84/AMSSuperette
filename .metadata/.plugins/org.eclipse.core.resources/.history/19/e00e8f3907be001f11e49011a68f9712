                    break;
            }
        }
    }

    

    
    private static void gererCommandes(Scanner scanner, Gestion gestion) {
        while (true) {
            System.out.println("=== Gestion des Commandes ===");
            System.out.println("1. Valider une commande");
            System.out.println("2. Reporter une commande");
            System.out.println("3. Modifier la quantité d'une commande");
            System.out.println("4. Choisir un fournisseur pour une commande");
            System.out.println("5. Retour au menu Vendeur");
            System.out.print("Votre choix : ");
            String choix = scanner.nextLine();

            switch (choix) {
                case "1":
                    Commande.validerCommande(scanner, gestion);
                    break;
                case "2":
                    Commande.reporterCommande(scanner, gestion);
                    break;
                case "3":
                    modifierQuantiteCommande(scanner, gestion);
