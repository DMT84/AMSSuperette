    private static void fournisseurMenu(Scanner scanner, Gestion gestion) {
        while (true) {
            System.out.println("=== Gérer les fournisseurs ===");
            System.out.println("1. Ajouter un fournisseur");
            System.out.println("2. Supprimer un fournisseur");
            System.out.println("3. Afficher les fournisseurs");
            System.out.println("4. Modifier un fournisseur");
            System.out.println("5. Retour au menu Vendeur");
            System.out.print("Votre choix : ");
            String choix = scanner.nextLine();

            switch (choix) {
                case "1":
                    ajouterfournisseur(scanner, gestion);
                    break;
                case "2":
                    supprimerFournisseur(scanner, gestion);
                    break;
