    private static void afficherStatistiques(Gestion gestion) {
        try {
            System.out.println("=== Statistiques des ventes ===");

            String queryJour = "select sum(prix * quantite) as total_benefices_jour, count(*) as total_ventes_jour from vente where date_vente = current_date";
            try (ResultSet rs = gestion.executeQuery(queryJour)) {
                if (rs.next()) {
                    System.out.println("Total des ventes aujourd'hui : " + rs.getInt("total_ventes_jour"));
                    System.out.println("Bénéfices aujourd'hui : " + rs.getDouble("total_benefices_jour"));
                }
            }

            String queryMois = "select sum(prix * quantite) as total_benefices_mois, count(*) as total_ventes_mois from vente where extract(month from date_vente) = extract(month from current_date) and extract(year from date_vente) = extract(year from current_date)";
            try (ResultSet rs = gestion.executeQuery(queryMois)) {
                if (rs.next()) {
                    System.out.println("Total des ventes ce mois-ci : " + rs.getInt("total_ventes_mois"));
                    System.out.println("Bénéfices ce mois-ci : " + rs.getDouble("total_benefices_mois"));
                }
            }

            System.out.println("\nTop 10 des ventes en quantité :");
            String queryTopQuantite = "select id_lot, sum(quantite) as total_quantite from vente group by id_lot order by total_quantite desc limit 10";
            try (ResultSet rs = gestion.executeQuery(queryTopQuantite)) {
                while (rs.next()) {
                    System.out.println("ID Lot : " + rs.getInt("id_lot") + ", Quantité vendue : " + rs.getInt("total_quantite"));
                }
            }

            System.out.println("\nTop 10 des ventes en bénéfices :");
            String queryTopBenefices = "select id_lot, sum(prix * quantite) as total_benefices from vente group by id_lot order by total_benefices desc limit 10";
            try (ResultSet rs = gestion.executeQuery(queryTopBenefices)) {
                while (rs.next()) {
                    System.out.println("ID Lot : " + rs.getInt("id_lot") + ", Bénéfices : " + rs.getDouble("total_benefices"));
                }
            }

        } catch (SQLException e) {
            System.out.println("Erreur lors de l'affichage des statistiques : " + e.getMessage());
        }
    }
