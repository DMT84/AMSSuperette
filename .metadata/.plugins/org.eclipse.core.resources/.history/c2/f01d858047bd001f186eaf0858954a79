    private static void validerCommande(Scanner scanner, Gestion gestion) {
        System.out.print("Entrez l'ID de la commande à valider : ");
        String idCommandeStr = scanner.nextLine();
        try {
            int idCommande = Integer.parseInt(idCommandeStr);
            
            // Utiliser la méthode getter pour obtenir la connexion
            Connection conn = gestion.connection;
            
            // Vérifier si la commande a un fournisseur et la valider
            String query = "SELECT id_fournisseur, id_lot, quantite_commande FROM commande WHERE id_commande = ?";
            try (PreparedStatement stmt = conn.prepareStatement(query)) {
                stmt.setInt(1, idCommande);
                try (ResultSet rs = stmt.executeQuery()) {
                    if (rs.next()) {
                        int idFournisseur = rs.getInt("id_fournisseur");
                        int idLot = rs.getInt("id_lot");
                        int quantiteCommande = rs.getInt("quantite_commande");

                        if (idFournisseur != 0) {
                            // La commande a un fournisseur, on peut la valider
                            
                            // Insertion dans la table achat
                            String insertAchat = "INSERT INTO achat (id_fournisseur, id_produit, prix_unitaire, quantite_achat, date_achat) " +
                                                 "SELECT ?, p.id_produit, p.prix, ?, CURRENT_DATE " +
                                                 "FROM lot l JOIN produitAMS p ON l.id_achat = p.id_produit " +
                                                 "WHERE l.id_lot = ?";
                            try (PreparedStatement insertStmt = conn.prepareStatement(insertAchat)) {
                                insertStmt.setInt(1, idFournisseur);
                                insertStmt.setInt(2, quantiteCommande);
                                insertStmt.setInt(3, idLot);
                                insertStmt.executeUpdate();
                            }
                            
                            // Mettre à jour la quantité du produit dans la table produitAMS
                            String updateProduit = "UPDATE produitAMS p SET p.prix = p.prix " + // Aucun changement sur le prix
                                                   "WHERE p.id_produit IN (SELECT p.id_produit FROM lot l JOIN produitAMS p ON l.id_achat = p.id_produit WHERE l.id_lot = ?)";
                            try (PreparedStatement updateStmt = conn.prepareStatement(updateProduit)) {
                                updateStmt.setInt(1, idLot);
                                updateStmt.executeUpdate();
                            }
                            
                            // Mettre à jour le statut de la commande
                            String updateCommande = "UPDATE commande SET statut = 'Validée' WHERE id_commande = ?";
                            try (PreparedStatement updateStmt = conn.prepareStatement(updateCommande)) {
                                updateStmt.setInt(1, idCommande);
                                updateStmt.executeUpdate();
                                System.out.println("Commande validée et ajoutée dans l'achat.");
                            }
                        } else {
                            System.out.println("La commande n'a pas de fournisseur associé, impossible de valider.");
                        }
                    } else {
                        System.out.println("Commande non trouvée.");
                    }
                }
            }
        } catch (SQLException e) {
            System.out.println("Erreur lors de la validation de la commande : " + e.getMessage());
        } catch (NumberFormatException e) {
            System.out.println("ID de commande invalide.");
        }
    }





